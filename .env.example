# SSH credentials for fetching used space and logical date from Unix hosts.
# Copy to .env and set your values (do not commit .env).
# For logical date, the server runs 'sqla' in a login shell so your .profile
# (and alias sqla / APP_DB_* env vars) are loaded on the remote.

PORT=3000
SSH_USER=abpwrk1
SSH_PASSWORD=your_password_here

# JNext plan — separate SSH user for planman showinfo (Production plan end time).
# Host is the environment name in lowercase (e.g. illnqw8358). Leave blank to disable.
JNEXTPLAN_USER=
JNEXTPLAN_PASSWORD=

# Jenkins — "Clean space" triggers job ENV_CLEANUP (buildWithParameters: ENV + LIBS_CLEANUP).
# Use your NTNET ID as JENKINS_USER and your Jenkins API token as JENKINS_TOKEN.
JENKINS_URL=http://ilcechr084:8080
JENKINS_USER=your_ntnet_id
JENKINS_TOKEN=your_jenkins_api_token
# Optional if the job is not at top level (use path segments):
# JENKINS_JOB=ENV_CLEANUP
# If Jenkins is not at server root (e.g. http://host:8080/jenkins/):
# JENKINS_CONTEXT=jenkins

# Full bounce — J-Boot-PMX (different host than Clean space). Same JENKINS_USER; use a dedicated API token or JENKINS_TOKEN.
JENKINS_FULL_BOUNCE_URL=http://ilcechr042:8080
JENKINS_FULL_BOUNCE_TOKEN=your_jenkins_api_token_for_full_bounce
# JENKINS_FULL_BOUNCE_JOB=J-Boot-PMX
# JENKINS_FULL_BOUNCE_CONTEXT=
# If OnFailure still shows empty in Jenkins, copy the exact parameter name from the job config XML:
# JENKINS_FULL_BOUNCE_ON_FAILURE_NAME=OnFailure
# JENKINS_FULL_BOUNCE_ON_FAILURE_VALUE=skip
